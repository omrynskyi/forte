# Copy to .env (`cp .env.example .env`). Every value here is a LOCAL DEV default for fake data.
# Real secrets never go in the repo (NFR-8). The api reads FORTE_*, the web app reads FORTE_API_URL.

FORTE_ENV=dev
FORTE_DATABASE_URL=postgresql+psycopg://forte:forte@localhost:5432/forte
FORTE_TEST_DATABASE_URL=postgresql+psycopg://forte:forte@localhost:5432/forte_test

# Public dev-only Fernet key. Generate a real one with `make key`.
FORTE_ENCRYPTION_KEY=9M4KS6XrbaQX0kvWX_CWIqUPWRDGrJM2VayH8EeIATQ=

# Links in emails point here. For a phone on the same Wi-Fi use http://<laptop-LAN-IP>:3000
FORTE_WEB_BASE_URL=http://localhost:3000
# The mock payments provider calls the webhook back at this address
FORTE_API_BASE_URL=http://localhost:8000

FORTE_SESSION_COOKIE_SECURE=false
FORTE_DEV_LOGIN_ENABLED=true

# Email -> Mailpit (inbox at http://localhost:8025). Use "console" to print emails to the api log.
FORTE_EMAIL_SENDER=smtp
FORTE_SMTP_HOST=localhost
FORTE_SMTP_PORT=1025

# Payments mock (D8): webhook arrives this many seconds after approval; set "failed" to demo retry
FORTE_PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret
FORTE_MOCK_PAYOUT_DELAY_SECONDS=5
FORTE_MOCK_PAYOUT_OUTCOME=paid

# Object storage for paystub PDFs (D16). MinIO locally, AWS S3 in prod (leave S3_ENDPOINT empty).
FORTE_STORAGE_BACKEND=s3
# Where the API reaches storage. On the host: localhost:9100. Inside compose: http://minio:9000.
FORTE_S3_ENDPOINT=http://localhost:9100
# The host presigned URLs are signed for = what the BROWSER can reach. Never minio:9000.
# Phone demo on Wi-Fi: http://<laptop-LAN-IP>:9100
FORTE_S3_PUBLIC_ENDPOINT=http://localhost:9100
FORTE_S3_BUCKET=forte-paystubs
# Host ports for the MinIO container (docker compose reads these)
FORTE_MINIO_PORT=9100
FORTE_MINIO_CONSOLE_PORT=9101
FORTE_S3_REGION=us-east-1
FORTE_S3_ACCESS_KEY=forte
FORTE_S3_SECRET_KEY=forte-dev-secret
FORTE_PAYSTUB_URL_TTL_SECONDS=60

# Web (Next.js): where /api/* is proxied to (keeps the session cookie same-origin)
FORTE_API_URL=http://localhost:8000
